# Copy to .env and fill in the required values before production use.
# Load explicitly with: node --env-file=.env server.mjs
# Keep .env and database backups private.
PUBLIC_URL=https://notes.example.com
ACCESS_PASSWORD=
ENCRYPTION_KEY=
DATA_DIR=./.data
PORT=3000
HOST=127.0.0.1
# Enable only behind a loopback proxy that overwrites X-Real-IP.
TRUST_PROXY=
