{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Optional CLI deployment template. Dashboard Git deployment does not need this file.
  // Copy to wrangler.jsonc only if you intend to manage deployment bindings with Wrangler.
  "name": "mijian",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mijian-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // Leave preview unbound until you create a separate preview database.
  "env": { "preview": { "d1_databases": [] } }
}
